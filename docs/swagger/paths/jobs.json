          "schema": {
            "type": "integer",
            "format": "int32"
          },
          "x-veeam-spec": {
            "$ref": "#/components/schemas/JobsFilters"
          }
        },
        {
          "name": "limit",
          "description": "Maximum number of jobs to return.",
          "in": "query",
          "schema": {
            "type": "integer",
            "format": "int32",
            "default": 200
